---
/** Inline SVG icons (decorative: the parent control carries the label). */
interface Props {
	name:
		| "sound-on"
		| "sound-off"
		| "motion-on"
		| "motion-off"
		| "expand"
		| "collapse"
		| "rooms"
		| "close"
		| "arrow-left"
		| "arrow-right"
		| "arrow-up"
		| "arrow-down"
		| "plus"
		| "minus"
		| "external"
		| "info"
		| "compass";
	class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={["icon", className]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
	{name === "sound-on" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
			<path d="M15 9.2a4 4 0 0 1 0 5.6M17.6 6.8a7.5 7.5 0 0 1 0 10.4" />
		</g>
	)}
	{name === "sound-off" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
			<path d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
		</g>
	)}
	{name === "motion-on" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
			<path d="M3 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0M3 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
		</g>
	)}
	{name === "motion-off" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
			<path d="M3 9h18M3 15h18" />
		</g>
	)}
	{name === "expand" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
		</g>
	)}
	{name === "collapse" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
		</g>
	)}
	{name === "rooms" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
			<rect x="4" y="4" width="6.5" height="6.5" rx="1" />
			<rect x="13.5" y="4" width="6.5" height="6.5" rx="1" />
			<rect x="4" y="13.5" width="6.5" height="6.5" rx="1" />
			<rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1" />
		</g>
	)}
	{name === "close" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
			<path d="M6 6l12 12M18 6L6 18" />
		</g>
	)}
	{name === "arrow-left" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M19 12H5M11 6l-6 6 6 6" />
		</g>
	)}
	{name === "arrow-right" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</g>
	)}
	{name === "arrow-up" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 19V5M6 11l6-6 6 6" />
		</g>
	)}
	{name === "arrow-down" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 5v14M6 13l6 6 6-6" />
		</g>
	)}
	{name === "plus" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
			<path d="M12 5v14M5 12h14" />
		</g>
	)}
	{name === "minus" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
			<path d="M5 12h14" />
		</g>
	)}
	{name === "external" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" />
		</g>
	)}
	{name === "info" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
			<circle cx="12" cy="12" r="8.5" />
			<path d="M12 11v5.5M12 7.6v.2" />
		</g>
	)}
	{name === "compass" && (
		<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
			<circle cx="12" cy="12" r="8.5" />
			<path d="M15.5 8.5l-2 5-5 2 2-5z" />
		</g>
	)}
</svg>
