---
/**
 * Inline SVG icons (decorative: the parent control carries the label).
 * Drawn like signage: one even line, square ends, mitred corners.
 */
interface Props {
	name:
		| "sound-on"
		| "sound-off"
		| "pause"
		| "play"
		| "expand"
		| "collapse"
		| "rooms"
		| "close"
		| "arrow-left"
		| "arrow-right"
		| "arrow-up"
		| "arrow-down"
		| "plus"
		| "minus"
		| "external"
		| "info"
		| "compass"
		| "look"
		| "target";
	class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={["icon", className]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
	{name === "look" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M12 3.5v17M3.5 12h17M9.5 6l2.5-2.5L14.5 6M9.5 18l2.5 2.5 2.5-2.5M6 9.5 3.5 12 6 14.5M18 9.5l2.5 2.5-2.5 2.5" />
		</g>
	)}
	{name === "target" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5">
			<circle cx="12" cy="12" r="7.5" />
			<circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none" />
		</g>
	)}
	{name === "sound-on" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
			<path d="M15 9.2a4 4 0 0 1 0 5.6M17.6 6.8a7.5 7.5 0 0 1 0 10.4" />
		</g>
	)}
	{name === "sound-off" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
			<path d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
		</g>
	)}
	{name === "pause" && (
		<g fill="currentColor">
			<path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
		</g>
	)}
	{name === "play" && (
		<g fill="currentColor">
			<path d="M7.5 4.5 19 12 7.5 19.5z" />
		</g>
	)}
	{name === "expand" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
		</g>
	)}
	{name === "collapse" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
		</g>
	)}
	{name === "rooms" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter">
			<rect x="4" y="4" width="6.5" height="6.5" />
			<rect x="13.5" y="4" width="6.5" height="6.5" />
			<rect x="4" y="13.5" width="6.5" height="6.5" />
			<rect x="13.5" y="13.5" width="6.5" height="6.5" />
		</g>
	)}
	{name === "close" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
			<path d="M6 6l12 12M18 6L6 18" />
		</g>
	)}
	{name === "arrow-left" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M19 12H5M11 6l-6 6 6 6" />
		</g>
	)}
	{name === "arrow-right" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</g>
	)}
	{name === "arrow-up" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M12 19V5M6 11l6-6 6 6" />
		</g>
	)}
	{name === "arrow-down" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M12 5v14M6 13l6 6 6-6" />
		</g>
	)}
	{name === "plus" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
			<path d="M12 5v14M5 12h14" />
		</g>
	)}
	{name === "minus" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
			<path d="M5 12h14" />
		</g>
	)}
	{name === "external" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
			<path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" />
		</g>
	)}
	{name === "info" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
			<circle cx="12" cy="12" r="8.5" />
			<path d="M12 11v5.5M12 7.6v.2" />
		</g>
	)}
	{name === "compass" && (
		<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter">
			<circle cx="12" cy="12" r="8.5" />
			<path d="M15.5 8.5l-2 5-5 2 2-5z" />
		</g>
	)}
</svg>
