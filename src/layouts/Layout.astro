---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tour virtual 360° — Galería Serena. Exposición permanente de esculturas y pinturas." />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <title>{title}</title>

    <!-- Google Fonts: Playfair Display (serif) + Inter (sans-serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ─── Reset ─────────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --color-bg: #0e0d0c;
    --color-surface: rgba(20, 19, 18, 0.85);
    --color-surface-solid: #141312;
    --color-gold: #C9A84C;
    --color-gold-light: #E8D48B;
    --color-gold-dim: rgba(201, 168, 76, 0.25);
    --color-text: #E8E4DC;
    --color-text-muted: rgba(232, 228, 220, 0.55);
    --color-border: rgba(201, 168, 76, 0.15);
    --font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --glass: rgba(14, 13, 12, 0.72);
    --glass-border: rgba(201, 168, 76, 0.12);
    --radius: 12px;
    --radius-sm: 8px;
    --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  html, body {
    height: 100%;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ─── Scrollbar ─────────────────────────────────────────────── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--color-gold-dim); border-radius: 3px; }

  /* ─── PSV Overrides ─────────────────────────────────────────── */
  .psv-container { background: var(--color-bg) !important; }
  .psv-navbar { display: none !important; }
  .psv-tooltip {
    font-family: var(--font-sans) !important;
    background: var(--glass) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    border: 1px solid var(--glass-border) !important;
    border-radius: var(--radius-sm) !important;
    color: var(--color-text) !important;
    font-size: 13px !important;
    padding: 8px 14px !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4) !important;
  }
  .psv-tooltip-arrow { border-color: transparent !important; display: none !important; }
  .psv-virtual-tour-tooltip { display: none !important; }

  /* ─── LightGallery theme overrides ──────────────────────────── */
  .lg-backdrop { background-color: rgba(10, 9, 8, 0.92) !important; }
  .lg-toolbar, .lg-actions .lg-next, .lg-actions .lg-prev {
    background-color: transparent !important;
  }
  .lg-toolbar .lg-icon { color: var(--color-gold-light) !important; }
  .lg-sub-html {
    font-family: var(--font-sans) !important;
    color: var(--color-text-muted) !important;
    font-size: 14px !important;
    padding: 16px 24px !important;
    background: linear-gradient(transparent, rgba(0,0,0,0.7)) !important;
  }
  .lg-counter { font-family: var(--font-sans) !important; color: var(--color-gold-dim) !important; }

  /* ─── Animations ────────────────────────────────────────────── */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes slideInLeft {
    from { transform: translateX(-20px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes slideInUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @keyframes scaleIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>
