---
import { Font } from "astro:assets";
import { site } from "../data/rooms";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** The exhibition itself (default). Reading pages such as About pass false and stay ordinary documents. */
	immersive?: boolean;
}

const { title, description, immersive = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}og.jpg`, Astro.site).href : undefined;

// Switch to the immersive layout before first paint when WebGL2 is likely
// available (the context itself is only created when the visitor enters).
// If the app has not started after a while (blocked or failed script),
// fall back to the readable document layout.
const BOOT = `(function () {
	var d = document.documentElement;
	if (!window.WebGL2RenderingContext || !window.createImageBitmap) return;
	d.classList.add("immersive", "is-intro");
	setTimeout(function () {
		if (!window.__itfBooted) d.classList.remove("immersive", "is-intro");
	}, 10000);
})();`;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		{/* the gallery is dark; anything read (these pages, and the exhibition without WebGL) is on paper */}
		<meta name="color-scheme" content={immersive ? "dark light" : "light"} />
		<meta name="theme-color" content={immersive ? "#07090b" : "#ecebe6"} />
		<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		{canonical && <link rel="canonical" href={canonical} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1200" />}
		{ogImage && <meta property="og:image:height" content="630" />}
		<meta property="og:image:alt" content="Four paintings side by side under spotlights in a dark gallery, mirrored in water: Hokusai's Great Wave, Hiroshige's bridge in the rain, Monet's lily pond and Turner's moonlit river. On a paper label beneath them: Inside the Frame, Vol. I — Water. Hokusai, Hiroshige, Monet, Turner." />
		<meta name="twitter:card" content="summary_large_image" />

		{immersive && <script is:inline set:html={BOOT} />}
		<Font cssVariable="--font-display" preload={[{ subset: "latin", style: "normal" }]} />
		<Font cssVariable="--font-text" preload={[{ subset: "latin", style: "normal" }]} />
	</head>
	<body>
		<slot />
	</body>
</html>
