---
import { Font } from "astro:assets";
import { site } from "../data/rooms";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}og.jpg`, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#07090b" />
		<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		{canonical && <link rel="canonical" href={canonical} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1200" />}
		{ogImage && <meta property="og:image:height" content="630" />}
		<meta property="og:image:alt" content="A dark gallery with Hokusai's Great Wave under a spotlight, reflected in still water on the floor." />
		<meta name="twitter:card" content="summary_large_image" />

		<script is:inline>
			// Switch to the immersive layout before first paint when WebGL2 is likely
			// available (the context itself is only created when the visitor enters).
			// If the app has not started after a while (blocked or failed script),
			// fall back to the readable document layout.
			(function () {
				var d = document.documentElement;
				if (!window.WebGL2RenderingContext || !window.createImageBitmap) return;
				d.classList.add("immersive", "is-intro");
				setTimeout(function () {
					if (!window.__itfBooted) d.classList.remove("immersive", "is-intro");
				}, 10000);
			})();
		</script>
		<Font cssVariable="--font-display" preload={[{ subset: "latin", style: "normal" }]} />
		<Font cssVariable="--font-text" preload={[{ subset: "latin" }]} />
	</head>
	<body>
		<slot />
	</body>
</html>
